{
  "name": "amazfit-race-stats",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Zepp OS mini app that shows a rider's live race standing on Amazfit watches.",
  "license": "MIT",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "version:sync": "node scripts/sync-app-version.mjs",
    "version:check": "node scripts/sync-app-version.mjs --check",
    "dev": "npx --yes @zeppos/zeus-cli@1.9.2 dev",
    "preview": "npx --yes @zeppos/zeus-cli@1.9.2 preview",
    "build": "npm run version:sync && npx --yes @zeppos/zeus-cli@1.9.2 build"
  },
  "dependencies": {
    "@zeppos/zml": "^0.0.43"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
